# 通过部署平台注入，或 uv run --no-sync --env-file .env python main.py 加载。
# 生产部署请设置长随机 Token。空值不代表关闭鉴权。
APP_API_TOKEN=
# 可选调用方配置：[{"name":"automation","token":"<token>","scopes":["read","submit"]}]
# APP_API_KEYS_JSON=[{"name":"automation","token":"<token>","scopes":["read","submit"]}]
APP_HOST=0.0.0.0
APP_PORT=8080

# 设置 URL 时优先于 DAGSTER_HOST / DAGSTER_PORT，可包含 /dagster 路径前缀。
DAGSTER_URL=
DAGSTER_HOST=webserver
DAGSTER_PORT=3000
# 旧提交接口通常无需填写 repository_name；特殊部署可修改此默认值，请求显式值优先。
# job_id 资源 API 使用 ID 中的实际 Repository，不受此默认值影响。
DAGSTER_REPOSITORY_NAME=__repository__
DAGSTER_TIMEOUT=120
DAGSTER_READINESS_TIMEOUT=3
# 上游鉴权示例：{"Authorization":"Bearer <upstream-token>"}
DAGSTER_HEADERS_JSON={}
# 可选，必须是存在的证书文件路径；TLS 验证保持开启。
DAGSTER_CA_BUNDLE=

# 单机 SQLite 持久化。Docker 内请使用 /data/idempotency.sqlite3 并挂载 /data。
IDEMPOTENCY_DB_PATH=./data/idempotency.sqlite3
IDEMPOTENCY_RETENTION_SECONDS=86400
IDEMPOTENCY_LEASE_SECONDS=30

# 输出文件只读根目录；Docker 中挂载相同路径，可附加 :ro。
RUN_OUTPUT_STORAGE_ROOT=/opt/dagster/dagster_home/storage
